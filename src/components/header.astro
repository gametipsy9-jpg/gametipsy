---
import ThemeSwitcher from "~/components/theme-switcher.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const searchData = allPosts.map((post) => ({
  title: post.data.title,
  excerpt: post.data.excerpt ?? "",
  category: post.data.category ?? "",
  slug: post.slug,
}));
---
<!-- Preconnect -->
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
<link rel="preconnect" href="https://supabase.co" crossorigin />

<!-- Preload fonts -->
<link rel="preload" href="/fonts/playfair-display-bold.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/lora-regular.woff2" as="font" type="font/woff2" crossorigin />
<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-24MH0H5FLN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-24MH0H5FLN');
</script>
<header
  id="page-header"
  class="fixed top-0 z-50 flex w-full items-center justify-between px-8 py-4 transition-all duration-300 border-b border-transparent font-ui"
>
  <a href="/" class="text-xl font-bold hover:opacity-80 transition-opacity">
    <span class="gradient-text">Game</span>tipsy
  </a>

  <div class="flex items-center gap-5">
    <nav class="hidden sm:block">
      <ul class="flex items-center gap-6 text-sm">
        <li><a href="/artikel" class="hover:text-secondary transition-colors">Artikel</a></li>
        <li><a href="/kategori" class="hover:text-secondary transition-colors">Kategori</a></li>
      </ul>
    </nav>

    <!-- Search -->
    <button id="search-toggle" type="button" aria-label="Search" class="hover:text-secondary transition-colors">
      <Icon name="mdi:magnify" class="size-5" />
    </button>

    <ThemeSwitcher />

    <button id="open-nav-button" type="button" class="sm:hidden" aria-label="Navigation">
      <Icon name="mdi:menu" class="size-5" />
    </button>
  </div>

  <!-- Search bar -->
  <div id="search-bar" class="hidden absolute top-full left-0 w-full border-b border-default bg-default px-8 py-3">
    <div class="max-w-2xl mx-auto flex items-center gap-3">
      <Icon name="mdi:magnify" class="size-5 text-offset flex-shrink-0" />
      <input
        id="search-input"
        type="text"
        placeholder="Cari artikel..."
        class="w-full bg-transparent text-sm outline-none placeholder:text-offset"
      />
      <button id="search-close" type="button" aria-label="Close search" class="hover:text-secondary transition-colors flex-shrink-0">
        <Icon name="mdi:close" class="size-5" />
      </button>
    </div>
    <!-- Search results dropdown -->
    <div id="search-results" class="hidden max-w-2xl mx-auto mt-2 pb-2"></div>
  </div>

  <!-- Mobile menu -->
  <div id="menu-modal" class="hidden fixed inset-0 z-50 bg-default px-8 py-6" aria-hidden="true">
    <div role="dialog" aria-modal="true">
      <div class="flex justify-between items-center mb-8">
        <span class="text-xl font-bold">
          <span class="gradient-text">Game</span>tipsy
        </span>
        <button id="close-nav-button" type="button" aria-label="Close navigation">
          <Icon name="mdi:close" class="size-5" />
        </button>
      </div>
      <nav>
        <ul class="flex flex-col gap-6 text-xl font-semibold">
          <li><a href="/artikel">Artikel</a></li>
          <li><a href="/kategori">Kategori</a></li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script define:vars={{ searchData }}>
  const header = document.querySelector("#page-header");
  const menuModal = document.querySelector("#menu-modal");
  const openBtn = document.querySelector("#open-nav-button");
  const closeBtn = document.querySelector("#close-nav-button");
  const searchToggle = document.querySelector("#search-toggle");
  const searchClose = document.querySelector("#search-close");
  const searchBar = document.querySelector("#search-bar");
  const searchInput = document.querySelector("#search-input");
  const searchResults = document.querySelector("#search-results");

  openBtn?.addEventListener("click", () => {
    menuModal.classList.remove("hidden");
    menuModal.setAttribute("aria-hidden", "false");
  });
  closeBtn?.addEventListener("click", () => {
    menuModal.classList.add("hidden");
    menuModal.setAttribute("aria-hidden", "true");
  });
  menuModal.querySelectorAll("a").forEach(a => {
    a.addEventListener("click", () => {
      menuModal.classList.add("hidden");
      menuModal.setAttribute("aria-hidden", "true");
    });
  });

  searchToggle?.addEventListener("click", () => {
    searchBar.classList.toggle("hidden");
    if (!searchBar.classList.contains("hidden")) {
      searchInput.focus();
    }
  });

  function closeSearch() {
    searchBar.classList.add("hidden");
    searchInput.value = "";
    searchResults.classList.add("hidden");
    searchResults.innerHTML = "";
  }

  searchClose?.addEventListener("click", closeSearch);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
  });

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();
    if (query.length < 2) {
      searchResults.classList.add("hidden");
      searchResults.innerHTML = "";
      return;
    }

    const matches = searchData.filter((post) =>
      post.title.toLowerCase().includes(query) ||
      post.excerpt.toLowerCase().includes(query) ||
      post.category.toLowerCase().includes(query)
    );

    if (matches.length === 0) {
      searchResults.innerHTML = `<p class="text-sm text-offset py-2">Tidak ada hasil untuk "<strong>${query}</strong>"</p>`;
    } else {
      searchResults.innerHTML = matches.map((post) => `
        <a href="/blog/${post.slug}" class="flex flex-col py-3 border-t border-default hover:text-secondary transition-colors">
          <span class="text-xs text-secondary uppercase tracking-wide mb-1">${post.category}</span>
          <span class="text-sm font-semibold">${post.title}</span>
          ${post.excerpt ? `<span class="text-xs text-offset mt-0.5 line-clamp-1">${post.excerpt}</span>` : ""}
        </a>
      `).join("");
    }
    searchResults.classList.remove("hidden");
  });

  document.addEventListener("scroll", () => {
    header.classList.toggle("scrolled-header", window.scrollY > 10);
  });
</script>

<style>
  .scrolled-header {
    border-color: var(--color-border);
    background-color: var(--color-background);
    backdrop-filter: blur(8px);
  }
</style>
