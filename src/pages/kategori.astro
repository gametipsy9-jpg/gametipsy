---
import Header from "~/components/header.astro";
import Footer from "~/components/footer.astro";
import "~/styles/index.css";
---
<!doctype html>
<html lang="id" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>Kategori — Gametipsy</title>
    <meta name="description" content="Jelajahi game obscure dan hidden gems berdasarkan kategori." />
    <script is:inline>
      const themeSaved = localStorage.getItem("theme");
      document.documentElement.dataset.theme = themeSaved ?? "dark";
    </script>
  </head>
  <body class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white font-sans">
    <Header />
    <section class="max-w-6xl mx-auto px-8 pt-36 pb-20">
      <div class="mb-12">
        <a href="/" class="text-sm text-offset hover:text-secondary transition-colors">← Kembali</a>
        <h1 class="text-4xl sm:text-5xl font-bold mt-6 mb-4 font-heading">Kategori</h1>
        <p class="text-offset text-lg">Jelajahi game berdasarkan kategori.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href="/kategori/random-finds" class="group rounded-2xl overflow-hidden border border-default bg-offset hover:border-secondary transition-colors p-8">
          <div class="text-4xl mb-4">🎲</div>
          <h2 class="text-2xl font-bold font-heading mb-2 group-hover:text-secondary transition-colors">Random Finds</h2>
          <p class="text-offset">Game yang ditemukan secara random, dicoba, dan ternyata seru.</p>
        </a>
        <a href="/kategori/hidden-gems" class="group rounded-2xl overflow-hidden border border-default bg-offset hover:border-secondary transition-colors p-8">
          <div class="text-4xl mb-4">💎</div>
          <h2 class="text-2xl font-bold font-heading mb-2 group-hover:text-secondary transition-colors">Hidden Gems</h2>
          <p class="text-offset">Game bagus yang jarang dilirik tapi surprisingly worth it.</p>
        </a>
      </div>
    </section>
    <Footer />
  </body>
</html>
