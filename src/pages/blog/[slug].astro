---
import { getCollection, getEntry } from "astro:content";
import Header from "~/components/header.astro";
import Footer from "~/components/footer.astro";
import "~/styles/index.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getEntry("blog", slug);
const { Content } = await post.render();
---
<!doctype html>
<html lang="id" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{post.data.title} — Gametipsy</title>
    <meta name="description" content={post.data.excerpt ?? post.data.title} />
    <script is:inline>
      const themeSaved = localStorage.getItem("theme");
      document.documentElement.dataset.theme = themeSaved ?? "dark";
    </script>
  </head>
  <body class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white font-sans">
    <Header />

    <!-- PROGRESS BAR -->
    <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-indigo-500 via-fuchsia-500 to-pink-500 z-[60] transition-all duration-100" style="width: 0%"></div>

    <article class="max-w-2xl mx-auto px-8 pt-36 pb-20">

      <!-- META -->
      <div class="mb-8">
        <a href="/" class="text-sm text-offset hover:text-secondary transition-colors">← Kembali</a>
        <div class="flex items-center gap-3 mt-6 mb-4">
          <span class="text-xs text-secondary uppercase tracking-wide">{post.data.category}</span>
          {post.data.label && (
            <span class="text-xs border border-default text-offset px-2 py-0.5 rounded-full">{post.data.label}</span>
          )}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold mb-4 font-heading">{post.data.title}</h1>
        {post.data.excerpt && (
          <p class="text-offset text-lg leading-relaxed font-quote italic">{post.data.excerpt}</p>
        )}
        <p class="text-xs text-offset mt-4">
          {post.data.date.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" })}
        </p>
      </div>

      <!-- THUMBNAIL -->
      {post.data.thumbnail && (
        <img
          src={post.data.thumbnail}
          alt={post.data.title}
          class="w-full rounded-2xl mb-10 aspect-video object-cover"
        />
      )}

<!-- WEIRDNESS SCALE -->
      {(post.data.weirdness_visual || post.data.weirdness_animasi || post.data.weirdness_audio || post.data.weirdness_desain || post.data.weirdness_nagih) && (
        <div class="mb-10 border border-default rounded-2xl p-6">
          <p class="text-xs uppercase tracking-widest text-offset mb-5">Weirdness Scale</p>
          {[
            { label: "Absurditas Visual", value: post.data.weirdness_visual },
            { label: "Kualitas Animasi", value: post.data.weirdness_animasi },
            { label: "Audio", value: post.data.weirdness_audio },
            { label: "Keputusan Desain Aneh", value: post.data.weirdness_desain },
            { label: "Bikin Penasaran", value: post.data.weirdness_nagih },
          ].filter(item => item.value !== undefined).map(({ label, value }) => (
            <div class="flex items-center gap-4 mb-3">
              <span class="text-sm text-offset w-48 shrink-0">{label}</span>
              <div class="flex-1 h-1.5 bg-default rounded-full overflow-hidden">
                <div
                  class="h-1.5 rounded-full bg-gradient-to-r from-indigo-500 via-fuchsia-500 to-pink-500"
                  style={`width: ${(value / 10) * 100}%`}
                />
              </div>
              <span class="text-sm text-offset w-6 text-right">{value}</span>
            </div>
          ))}
        </div>
      )}

      <!-- KONTEN -->
      <div class="prose prose-lg max-w-none
        prose-headings:font-heading prose-headings:text-default
        prose-p:text-default prose-p:leading-relaxed
        prose-a:text-secondary prose-a:no-underline hover:prose-a:underline
        prose-blockquote:font-quote prose-blockquote:text-offset prose-blockquote:border-secondary
        prose-strong:text-default
        prose-img:rounded-2xl">
        <Content />
      </div>

      <!-- REACTION -->
      <div class="mt-16 flex justify-center gap-4">
        {[
          { id: "boleh", emoji: "👍", label: "Boleh lah" },
          { id: "suka", emoji: "❤️", label: "Suka banget" },
          { id: "hmm", emoji: "🤔", label: "Hmm" },
        ].map(({ id, emoji, label }) => (
          <button
            data-reaction={id}
            class="reaction-btn flex flex-col items-center gap-1 px-5 py-3 rounded-2xl border border-default hover:border-secondary transition-colors text-sm"
          >
            <span class="text-2xl">{emoji}</span>
            <span class="text-offset text-xs">{label}</span>
          </button>
        ))}
      </div>

      <!-- TRAKTEER -->
      <div class="mt-8 flex justify-center">
        
        <a href="https://trakteer.id/gametipsy"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary px-8 py-3 rounded-full text-sm font-semibold font-ui"
        >
          Trakteer Gametipsy
        </a>
      </div>

     <!-- BAGIKAN -->
      <div class="mt-10">
        <p class="text-sm font-semibold text-default mb-4">Bagikan artikel ini</p>
        <div class="flex gap-3">

          <!-- Copy Link -->
          <button
            data-gt-share="clipboard"
            data-gt-url={Astro.url.href}
            data-gt-text={post.data.title}
            title="Copy Link"
            class="share-btn w-11 h-11 rounded-xl border border-default flex items-center justify-center text-offset hover:text-secondary hover:border-secondary transition-all duration-200 hover:scale-110"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
          </button>

          <!-- Twitter/X -->
          <button
            data-gt-share="twitter"
            data-gt-url={Astro.url.href}
            data-gt-text={post.data.title}
            title="Bagikan ke X"
            class="share-btn w-11 h-11 rounded-xl border border-default flex items-center justify-center text-offset hover:text-secondary hover:border-secondary transition-all duration-200 hover:scale-110"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </button>

          <!-- Facebook -->
          <button
            data-gt-share="facebook"
            data-gt-url={Astro.url.href}
            data-gt-text={post.data.title}
            title="Bagikan ke Facebook"
            class="share-btn w-11 h-11 rounded-xl border border-default flex items-center justify-center text-offset hover:text-secondary hover:border-secondary transition-all duration-200 hover:scale-110"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </button>

          <!-- WhatsApp -->
          <button
            data-gt-share="whatsapp"
            data-gt-url={Astro.url.href}
            data-gt-text={post.data.title}
            title="Bagikan ke WhatsApp"
            class="share-btn w-11 h-11 rounded-xl border border-default flex items-center justify-center text-offset hover:text-secondary hover:border-secondary transition-all duration-200 hover:scale-110"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </button>

        </div>
      </div>

    </article>

    <Footer />

    <script>
      // Progress bar
      const bar = document.getElementById("progress-bar");
      document.addEventListener("scroll", () => {
        const total = document.body.scrollHeight - window.innerHeight;
        const progress = (window.scrollY / total) * 100;
        if (bar) bar.style.width = progress + "%";
      });

      // Reaction button
      const btns = document.querySelectorAll(".reaction-btn");
      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          btns.forEach((b) => b.classList.remove("border-secondary", "text-secondary"));
          btn.classList.add("border-secondary", "text-secondary");
        });
      });
    </script>

    <script is:inline>
      function attachSocialShareEvents() {
        const shareButtons = document.querySelectorAll("[data-gt-share]");
        shareButtons.forEach((elem) => {
          elem.addEventListener("click", handleSocialShare, false);
        });
      }
      function handleSocialShare(event) {
        const elem = event.currentTarget;
        const network = elem.getAttribute("data-gt-share");
        const rawUrl = elem.getAttribute("data-gt-url");
        const rawText = elem.getAttribute("data-gt-text");
        if (network === "clipboard") {
          copyToClipboard(rawUrl);
          return;
        }
        if (navigator.share && /Mobi|Android/i.test(navigator.userAgent)) {
          navigator.share({ title: rawText, text: rawText, url: rawUrl }).catch(() => {
            openSocialShare(network, rawUrl, rawText);
          });
        } else {
          openSocialShare(network, rawUrl, rawText);
        }
      }
      function copyToClipboard(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(() => {
            fallbackCopyTextToClipboard(text);
          });
        } else {
          fallbackCopyTextToClipboard(text);
        }
      }
      function openSocialShare(network, rawUrl, rawText) {
        const url = encodeURIComponent(rawUrl);
        const text = encodeURIComponent(rawText);
        const platformUrls = {
          facebook: `https://www.facebook.com/sharer.php?u=${url}`,
          twitter: `https://twitter.com/intent/tweet?url=${url}&text=${text}`,
          whatsapp: `https://wa.me/?text=${text}%20${url}`,
        };
        const href = platformUrls[network];
        if (href) {
          window.open(href, "_blank", "width=600,height=400,scrollbars=yes,resizable=yes,noopener,noreferrer");
        }
      }
      function fallbackCopyTextToClipboard(text) {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.left = "-999999px";
        textArea.style.top = "-999999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try { document.execCommand("copy"); } catch (err) {}
        document.body.removeChild(textArea);
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", attachSocialShareEvents);
      } else {
        attachSocialShareEvents();
      }
    </script>
  </body>
</html>
